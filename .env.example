# Optional. Without DATABASE_URL a local SQLite file (workpaper.db) is used.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional. Without it, AI explanations are shown as unavailable; everything else works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_RATE_PER_HOUR=30
